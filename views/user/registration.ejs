<%- include('../partials/mainheader.ejs')%>
<style>
    #name::placeholder {
        color: #999;
        font-style: italic;
    }
    #email::placeholder {
        color: #999;
        font-style: italic;
    }
    #password::placeholder {
        color: #999;
        font-style: italic;
    }
    #mno::placeholder {
        color: #999;
        font-style: italic;
    }
    #referdid::placeholder {
        color: #999;
        font-style: italic;
    }

    /* Message styling */
    .message-text {
        color: #E97730;
        text-align: center;
        font-weight: 500;
        margin-bottom: 15px;
    }

    .error-message {
        color: #E97730;
        font-size: 14px;
        margin-top: 5px;
    }
</style>
      
<div class="login-register-area" style="padding-top: 30px;">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 col-md-12 offset-lg-2">
                <div class="login-register-wrapper">
                    <div class="login-register-tab-list nav">
                        <a href="/auth/login/">
                            <h4> login </h4>
                        </a>
                        <a class="active" href="#lg2">
                            <h4> register </h4>
                        </a>
                    </div>
                    <div class="tab-content">
                        <div id="lg1" class="tab-pane active">
                            <div class="login-form-container">
                                <div class="login-register-form">

                                    <p id="show1" class="message-text"></p>

                                    <% if(typeof message !=='undefined' ){ %>
                                        <p class="message-text">
                                            <%= message %>
                                        </p>
                                    <% } %>
                                    
                                    <form action="" onsubmit="return handleSubmit()" method="post" novalidate>
                                        <label>Enter your Name :</label>
                                        <input type="text" id="name" name="name" placeholder="your name" required>
                                        
                                        <label>Enter your Email :</label>
                                        <input type="email" id="email" name="email" placeholder="(e.g., example@example.com)" required>
                                        
                                        <label>Enter your Mobile/phone No :</label>
                                        <input type="number" id="mno" name="mno" placeholder="10 Digit mobile no" required>
                                        
                                        <label>Enter your Password :</label>
                                        <input type="password" id="password" name="password" placeholder="5 Digit Password" required>
                                        
                                        <label>Referral Id :</label>
                                        <input type="text" id="referdid" name="referdid" placeholder="Optional">
                                        
                                        <div class="button-box btn-hover" style="justify-content: center; align-items: center; display: flex;">
                                            <button type="submit">Register</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<br>
<br>

<script>
    let show = document.getElementById("show1");

    function handleSubmit() {
        // Clear previous error messages
        show.innerHTML = "";
        
        let username = document.getElementById("name").value;
        let email = document.getElementById("email").value;
        let mobile = document.getElementById("mno").value;
        let password = document.getElementById("password").value;
        let referralId = document.getElementById("referdid").value;

        // Name validation - cannot be empty and should contain only letters and spaces
        let nameRegex = /^[a-zA-Z\s]+$/;
        if (username.trim() === "") {
            show.innerHTML = "Name cannot be empty";
            return false;
        }
        if (!username.match(nameRegex)) {
            show.innerHTML = "Name should contain only letters and spaces";
            return false;
        }

        // Email validation
        let emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!email.match(emailRegex)) {
            show.innerHTML = "Please enter a valid email address";
            return false;
        }

        // Mobile validation - exactly 10 digits
        let mobileRegex = /^\d{10}$/;
        if (!mobile.match(mobileRegex)) {
            show.innerHTML = "Mobile number must be exactly 10 digits";
            return false;
        }

        // Password validation - exactly 5 digits
        let passwordRegex = /^\d{5}$/;
        if (!password.match(passwordRegex)) {
            show.innerHTML = "Password must be exactly 5 digits";
            return false;
        }

        // Referral ID is optional - no validation needed
        // If referralId is empty, it's okay

        return true;
    }
</script>

<%- include('../partials/mainfooter.ejs')%>