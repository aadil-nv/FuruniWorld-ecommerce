<%- include('../partials/mainheader.ejs') %>

<style>
    :root {
        --primary-color: #E97730;
        --secondary-color: #E97730;
        --text-dark: #2c3e50;
        --text-muted: #7f8c8d;
        --success-color: #2ecc71;
        --warning-color: #f39c12;
        --danger-color: #e74c3c;
    }
    * {
        font-family: 'Inter', Arial, Helvetica, sans-serif;
    }

    .my-account-wrapper {
        background: #f8f9fa;
        min-height: 100vh;
    }

    .container {
        max-width: 1200px;
    }

    .error-message {
        color: var(--danger-color);
        text-align: center;
        margin: 15px 0;
        padding: 10px;
        border-radius: 5px;
        background: rgba(231, 76, 60, 0.1);
    }

    /* Tab Menu Styles */
    .myaccount-tab-menu {
        background: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        margin-bottom: 30px;
    }

    .myaccount-tab-menu a {
        display: flex;
        align-items: center;
        padding: 15px;
        margin-bottom: 10px;
        border-radius: 8px;
        color: var(--text-dark);
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .myaccount-tab-menu a:hover,
    .myaccount-tab-menu a.active {
        background: linear-gradient(45deg, var(--primary-color), var(--secondary-color));
        color: white;
        transform: translateX(5px);
    }

    /* Content Styles */
    .myaccount-content {
        background: white;
        border-radius: 10px;
        padding: 30px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        margin-bottom: 30px;
    }

    .myaccount-content h3 {
        color: var(--text-dark);
        font-weight: 600;
        margin-bottom: 20px;
        border-bottom: 2px solid var(--primary-color);
        padding-bottom: 10px;
    }

    /* Coupon Card Styles */
    .coupon-card {
        display: flex;
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        border-radius: 15px;
        margin-bottom: 20px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
    }

    .coupon-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.15);
    }

    .coupon-left {
        background: rgba(255,255,255,0.1);
        backdrop-filter: blur(10px);
        padding: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 180px;
    }

    .coupon-code {
        text-align: center;
        color: white;
    }

    .code-text {
        font-size: 20px;
        font-weight: bold;
        letter-spacing: 2px;
        margin-bottom: 10px;
    }

    .copy-btn {
        background: rgba(255,255,255,0.2);
        border: 1px solid rgba(255,255,255,0.3);
        padding: 8px 15px;
        border-radius: 20px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 12px;
        font-weight: 600;
        color: white;
    }

    .copy-btn:hover {
        background: rgba(255,255,255,0.3);
        transform: scale(1.05);
    }

    .coupon-separator {
        width: 2px;
        background: transparent;
        position: relative;
    }

    .circle-top, .circle-bottom {
        width: 16px;
        height: 16px;
        background: #f8f9fa;
        border-radius: 50%;
        position: absolute;
        left: -8px;
    }

    .circle-top { top: -8px; }
    .circle-bottom { bottom: -8px; }

    .dashed-line {
        height: 100%;
        border-left: 2px dashed rgba(255,255,255,0.4);
        position: absolute;
        left: 0;
    }

    .coupon-right {
        flex: 1;
        padding: 20px;
        background: white;
    }

    .coupon-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .coupon-title {
        font-size: 20px;
        font-weight: 600;
        color: var(--text-dark);
        margin: 0;
    }

    .coupon-discount {
        background: linear-gradient(45deg, #ff6b6b, #ee5a24);
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: bold;
        font-size: 14px;
    }

    .coupon-description {
        color: var(--text-muted);
        font-size: 13px;
        margin-bottom: 15px;
        line-height: 1.5;
    }

    .coupon-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 20px;
        margin-bottom: 15px;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .detail-item .label {
        font-size: 11px;
        color: var(--text-muted);
        font-weight: 600;
        text-transform: uppercase;
    }

    .detail-item .value {
        font-size: 13px;
        color: var(--text-dark);
        font-weight: 600;
    }

    .coupon-status {
        display: flex;
        justify-content: flex-end;
    }

    .status {
        padding: 5px 10px;
        border-radius: 15px;
        font-size: 10px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .status.active {
        background: var(--success-color);
        color: white;
    }

    .status.expiring {
        background: var(--warning-color);
        color: white;
    }

    .status.expired {
        background: var(--danger-color);
        color: white;
    }

    /* Pagination Styles */
    .pagination-container {
        margin-top: 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        padding: 15px;
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .pagination-info {
        color: var(--text-muted);
        font-size: 13px;
    }

    .pagination-controls {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .pagination-btn {
        background: linear-gradient(45deg, var(--primary-color), var(--secondary-color));
        color: white;
        border: none;
        padding: 8px 15px;
        border-radius: 20px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .pagination-btn:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(102,126,234,0.3);
    }

    .pagination-btn:disabled {
        background: #bdc3c7;
        cursor: not-allowed;
    }

    .page-numbers {
        display: flex;
        gap: 5px;
    }

    .page-number {
        width: 35px;
        height: 35px;
        border: 2px solid var(--primary-color);
        background: transparent;
        color: var(--primary-color);
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        transition: all 0.3s ease;
    }

    .page-number:hover, .page-number.active {
        background: var(--primary-color);
        color: white;
        transform: scale(1.1);
    }

    /* No Coupons State */
    .no-coupons {
        text-align: center;
        padding: 40px 20px;
        background: white;
        border-radius: 10px;
        margin-top: 20px;
    }

    .no-coupons-icon {
        font-size: 48px;
        margin-bottom: 15px;
        color: var(--text-muted);
    }

    /* Order Card Styles */
     .order-card {
        border: 1px solid #ddd;
        border-radius: 8px;
        margin-bottom: 20px;
        background-color: #fff;
        padding: 10px;
    }

    .textorderstatus {
        font-weight: 600;
        padding: 5px 10px;
        border-radius: 4px;
        display: inline-block;
    }

    .textorderstatus.payment-failed {
        background-color: #f8d7da;
        color: #721c24;
    }

    .pay-now-btn {
        background-color: #ff6200;
        color: white;
        padding: 8px 16px;
        border: none;
        border-radius: 4px;
        text-decoration: none;
        font-size: 14px;
        cursor: pointer;
        margin-left: 10px;
        transition: background-color 0.3s;
    }

    .pay-now-btn:hover {
        background-color: #e55a00;
    }

    .check-btn {
        background-color: #28a745;
        color: white;
        padding: 8px 16px;
        border-radius: 4px;
        text-decoration: none;
        font-size: 14px;
    }

    .no-coupons {
        text-align: center;
        padding: 20px;
        background-color: #f8f9fa;
        border-radius: 8px;
    }

    .no-coupons-icon {
        font-size: 40px;
        color: #6c757d;
        margin-bottom: 10px;
    }

    /* Wallet Table Styles */
    .myaccount-table table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        overflow: hidden;
    }

    .myaccount-table th,
    .myaccount-table td {
        padding: 15px;
        text-align: center;
    }

    /* Address Table Styles */
    .address-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .address-table th,
    .address-table td {
        padding: 15px;
        border-bottom: 1px solid #e0e0e0;
    }

    /* Button Styles */
    .check-btn {
        background: linear-gradient(45deg, var(--primary-color), var(--secondary-color));
        color: white;
        padding: 8px 15px;
        border-radius: 5px;
        border: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .check-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(102,126,234,0.3);
    }

    /* Responsive Design */
    @media (max-width: 991px) {
        .myaccount-tab-menu {
            margin-bottom: 20px;
        }

        .coupon-card {
            flex-direction: column;
        }

        .coupon-left {
            min-width: 100%;
            padding: 15px;
        }

        .coupon-separator {
            width: 100%;
            height: 2px;
        }

        .circle-top, .circle-bottom {
            display: none;
        }

        .dashed-line {
            width: 100%;
            height: 2px;
            border-left: none;
            border-top: 2px dashed rgba(255,255,255,0.4);
        }

        .coupon-details {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 767px) {
        .pagination-container {
            flex-direction: column;
            text-align: center;
        }

        .order-card .row {
            flex-direction: column;
        }

        .address-table {
            font-size: 14px;
        }
    }
    .textorderstatus.returned {
        color: rgb(148, 116, 11);
    }
    .textorderstatus.order-cancelled {
        color: red;
    }
    .textorderstatus.delivered {
        color: rgb(11, 128, 50);
    }
    .textorderstatus.pending {
        color: rgb(21, 6, 151);
    }
    .textorderstatus {
        color: black;
    }
    
</style>

<div class="my-account-wrapper pb-30 pt-30">
    <div class="container">
        <div class="error-message" id="errorMessage1">
            <%= locals.added %>
        </div>
        <% if(typeof message !== 'undefined') { %>
            <div class="error-message" id="errorMessage2">
                <%= message %>
            </div>
        <% } %>

        <div class="row">
            <div class="col-lg-12">
                <div class="myaccount-page-wrapper">
                    <div class="row">
                        <div class="col-lg-3 col-md-4">
                            <div class="myaccount-tab-menu nav" role="tablist">
                                <a href="#dashboad" class="active" data-bs-toggle="tab"><i class="material-icons">person</i> Profile</a>
                                <a href="#orders" data-bs-toggle="tab"><i class="material-icons">shopping_cart</i> Orders</a>
                                <a href="#download" data-bs-toggle="tab"><i class="material-icons">account_balance_wallet</i> Wallet</a>
                                <a href="#Coupons" data-bs-toggle="tab"><i class="material-icons">payments</i> Coupons</a>
                                <a href="#address-edit" data-bs-toggle="tab"><i class="material-icons">contact_mail</i> Address</a>
                                <a href="#account-info" data-bs-toggle="tab"><i class="material-icons">phonelink_lock</i> Change Password</a>
                                <a href="/auth/logout" onclick="confirmLogout(event)"><i class="material-icons">logout</i> Logout</a>
                            </div>
                        </div>

                        <div class="col-lg-9 col-md-8">
                            <div class="tab-content" id="myaccountContent">
                                <!-- Profile Tab -->
                                <div class="tab-pane fade show active" id="dashboad" role="tabpanel">
                                    <div class="myaccount-content">
                                        <h3>Personal Information</h3>
                                        <div class="welcome">
                                            <h6>Name: <%= userData.name %></h6>
                                            <h6>Email: <%= userData.email %></h6>
                                            <h6>Mobile: <%= userData.mobile %></h6>
                                        </div>
                                        <div class="single-input-item btn-hover mt-4">
                                            <a href="/edituserdetiles" class="check-btn">Edit Details</a>
                                        </div>
                                    </div>
                                    <div class="myaccount-content">
                                        <h3>Your Referral ID</h3>
                                        <div class="welcome d-flex align-items-center gap-3">
                                            <input type="text" id="referalInput" value="<%= userData.referalId %>" readonly class="form-control">
                                            <button class="check-btn" onclick="copyReferalId()">COPY ID</button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Orders Tab -->
                                <div class="tab-pane fade" id="orders" role="tabpanel">
                                    <div class="myaccount-content">
                                        <h3>Orders History</h3>
                                        <% if(orderData.length > 0) { %>
                                            <div id="order-container">
                                                <% orderData.forEach((item, index) => { %>
                                                    <% item.orderedItem.forEach((product) => { %>
                                                        <div class="order-item" data-index="<%= index %>">
                                                            <div class="order-card">
                                                                <div class="row g-0 align-items-center">
                                                                    <div class="col-md-2">
                                                                        <img src="/uploads/<%= product.productId.productimage[0] %>"
                                                                             class="img-fluid rounded-start"
                                                                             style="max-width: 80px; margin: 10px;">
                                                                    </div>
                                                                    <div class="col-md-4">
                                                                        <div class="card-body">
                                                                            <h6 class="card-title"><%= product.productId.productname %></h6>
                                                                            <p class="card-text text-muted">Qty: <%= product.quantity %></p>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-2">
                                                                        <div class="card-body">
                                                                            <p class="card-title">₹<%= product.totalProductAmount %></p>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-4">
                                                                        <div class="card-body">
                                                                            <p class="card-title textorderstatus <%= product.productStatus.toLowerCase().replace(' ', '-') %>">
                                                                                <%= product.productStatus %>
                                                                            </p>
                                                                            <% if(item.paymentStatus !== 'Payment Failed') { %>
                                                                                <a href="/order/orders/<%= item._id %>" class="check-btn">Details</a>
                                                                            <% } %>
                                                                            <% if(item.paymentStatus === 'Payment Failed') { %>
                                                                                <button class="pay-now-btn" onclick="handlePayNow('<%= item._id %>', '<%= item.orderId %>', '<%= product.productId._id %>')">Pay Now</button>
                                                                            <% } %>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    <% }); %>
                                                <% }) %>
                                            </div>
                                            <div class="pagination-container">
                                                <div class="pagination-info">
                                                    <span id="order-showing-info">Showing 1-5 of <%= orderData.length %> orders</span>
                                                </div>
                                                <div class="pagination-controls">
                                                    <button id="order-prev-btn" class="pagination-btn" onclick="changeOrderPage(-1)">
                                                        <i class="fas fa-chevron-left"></i> Previous
                                                    </button>
                                                    <div id="order-page-numbers" class="page-numbers"></div>
                                                    <button id="order-next-btn" class="pagination-btn" onclick="changeOrderPage(1)">
                                                        Next <i class="fas fa-chevron-right"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        <% } else { %>
                                            <div class="no-coupons">
                                                <div class="no-coupons-icon">
                                                    <i class="fas fa-shopping-cart"></i>
                                                </div>
                                                <h4>No Orders Found</h4>
                                                <p>Start shopping to see your order history!</p>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Wallet Tab -->
                                <div class="tab-pane fade" id="download" role="tabpanel">
                                    <div class="myaccount-content">
                                        <h3>Wallet</h3>
                                        <div class="myaccount-table table-responsive text-center">
                                            <table class="table table-bordered">
                                                <thead>
                                                    <tr>
                                                        <th>Wallet Balance</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td>Rs.<%= userData.wallet.toFixed(0) %>/-</td>

                                                    </tr>
                                                </tbody>
                                            </table>
                                            <div class="mt-3">
                                                <button type="button" class="check-btn" data-bs-toggle="modal" data-bs-target=".bd-example-modal-lg">
                                                    Wallet History
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Coupons Tab -->
                                <div class="tab-pane fade" id="Coupons" role="tabpanel">
                                    <div class="myaccount-content">
                                        <h3>Available Coupons</h3>
                                        <% if(couponData.length) { %>
                                            <div id="coupon-container">
                                                <% couponData.forEach((item, index) => { %>
                                                    <div class="coupon-item" data-index="<%= index %>">
                                                        <div class="coupon-card">
                                                            <div class="coupon-left">
                                                                <div class="coupon-code">
                                                                    <div class="code-text"><%= item.couponCode %></div>
                                                                    <div class="copy-btn" onclick="copyCouponCode('<%= item.couponCode %>')">
                                                                        <i class="fas fa-copy"></i> COPY
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="coupon-separator">
                                                                <div class="circle-top"></div>
                                                                <div class="dashed-line"></div>
                                                                <div class="circle-bottom"></div>
                                                            </div>
                                                            <div class="coupon-right">
                                                                <div class="coupon-header">
                                                                    <h4 class="coupon-title"><%= item.couponName %></h4>
                                                                    <div class="coupon-discount">₹<%= item.discountAmount %> OFF</div>
                                                                </div>
                                                                <p class="coupon-description"><%= item.couponDescription %></p>
                                                                <div class="coupon-details">
                                                                    <div class="detail-item">
                                                                        <span class="label">Min Amount:</span>
                                                                        <span class="value">₹<%= item.minAmount %></span>
                                                                    </div>
                                                                    <div class="detail-item">
                                                                        <span class="label">Expires:</span>
                                                                        <span class="value"><%= new Date(item.expiryDate).toLocaleDateString('en-IN', {day: 'numeric', month: 'short', year: 'numeric'}) %></span>
                                                                    </div>
                                                                </div>
                                                                <div class="coupon-status">
                                                                    <% 
                                                                        const today = new Date();
                                                                        const expiryDate = new Date(item.expiryDate);
                                                                        const isExpired = today > expiryDate;
                                                                        const daysLeft = Math.ceil((expiryDate - today) / (1000 * 60 * 60 * 24));
                                                                    %>
                                                                    <% if(isExpired) { %>
                                                                        <span class="status expired">EXPIRED</span>
                                                                    <% } else if(daysLeft <= 7) { %>
                                                                        <span class="status expiring">EXPIRES SOON</span>
                                                                    <% } else { %>
                                                                        <span class="status active">ACTIVE</span>
                                                                    <% } %>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                <% }) %>
                                            </div>
                                            <div class="pagination-container">
                                                <div class="pagination-info">
                                                    <span id="showing-info">Showing 1-5 of <%= couponData.length %> coupons</span>
                                                </div>
                                                <div class="pagination-controls">
                                                    <button id="prev-btn" class="pagination-btn" onclick="changePage(-1)">
                                                        <i class="fas fa-chevron-left"></i> Previous
                                                    </button>
                                                    <div id="page-numbers" class="page-numbers"></div>
                                                    <button id="next-btn" class="pagination-btn" onclick="changePage(1)">
                                                        Next <i class="fas fa-chevron-right"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        <% } else { %>
                                            <div class="no-coupons">
                                                <div class="no-coupons-icon">
                                                    <i class="fas fa-ticket-alt"></i>
                                                </div>
                                                <h4>No Coupons Available</h4>
                                                <p>Check back later for exciting offers!</p>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Address Tab -->
                                <div class="tab-pane fade" id="address-edit" role="tabpanel">
                                    <div class="myaccount-content">
                                        <% if (addressData.length < 6) { %>
                                            <a href="/adduseraddress/<%= userData._id %>" class="check-btn float-end mb-3">
                                                <i class="fa-solid fa-square-plus"></i> Add Address
                                            </a>
                                        <% } %>
                                        <h3>Billing Address</h3>
                                        <% if(addressData.length > 0) { %>
                                            <% addressData.forEach(data => { %>
                                                <div class="address-table mb-4">
                                                    <table>
                                                        <tr>
                                                            <th>Name:</th>
                                                            <td><%= data.name %></td>
                                                        </tr>
                                                        <tr>
                                                            <th>Mobile:</th>
                                                            <td><%= data.mobile %></td>
                                                        </tr>
                                                        <tr>
                                                            <th>Address:</th>
                                                            <td><%= data.address %></td>
                                                        </tr>
                                                        <tr>
                                                            <th>Street:</th>
                                                            <td><%= data.streetaddress %></td>
                                                        </tr>
                                                        <tr>
                                                            <th>City:</th>
                                                            <td><%= data.city %></td>
                                                        </tr>
                                                        <tr>
                                                            <th>State:</th>
                                                            <td><%= data.state %></td>
                                                        </tr>
                                                        <tr>
                                                            <th>Pincode:</th>
                                                            <td><%= data.pincode %></td>
                                                        </tr>
                                                        <tr>
                                                            <th>Landmark:</th>
                                                            <td><%= data.landmark %></td>
                                                        </tr>
                                                        <tr>
