<div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Wallet History</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="myaccount-table table-responsive text-center">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Reason</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="wallet-history-container">
                        <% userData.walletHistory.forEach((item, index) => { %>
                            <tr class="wallet-history-item" data-index="<%= index %>">
                                <td><%= item.date.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
                                <td><%= item.description %></td>
                                
                                        <td class="<%= item.status.toLowerCase() === 'credit' ? 'green' : 'text-danger' %>">
                                                <%= item.status.toLowerCase() === 'credit' ? '+' : '-' %>₹<%= Number(item.amount).toFixed(2) %>
                                            </td>

                                <td>
                                    <span class="status <%= item.status.toLowerCase() === 'credit' ? 'active' : 'expired' %>">
                                        <%= item.status %>
                                    </span>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <div class="pagination-container m-3">
                <div class="pagination-info">
                    <span id="wallet-showing-info">Showing 1-<%= Math.min(10, userData.walletHistory.length) %> of <%= userData.walletHistory.length %> entries</span>
                </div>
                <div class="pagination-controls">
                    <button id="wallet-prev-btn" class="pagination-btn" onclick="changeWalletPage(-1)">
                        <i class="fas fa-chevron-left"></i> Previous
                    </button>
                    <div id="wallet-page-numbers" class="page-numbers"></div>
                    <button id="wallet-next-btn" class="pagination-btn" onclick="changeWalletPage(1)">
                        Next <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    // Error message auto-hide
    function hideErrorMessages() {
        ['errorMessage1', 'errorMessage2'].forEach(id => {
            const element = document.getElementById(id);
            if (element) {
                setTimeout(() => element.remove(), 2000);
            }
        });
    }

    // Delete address confirmation
    function confirmdelete(id) {
        Swal.fire({
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, delete it!"
        }).then((result) => {
            if (result.isConfirmed) {
                fetch(`/deleteaddress/${id}`, {
                    method: "DELETE",
                    headers: { "Content-Type": "application/json" }
                })
                    .then(response => response.json())
                    .then(data => {
                        Swal.fire("Deleted!", "Your address has been deleted.", "success");
                        window.location.reload();
                    })
                    .catch(err => console.error(err));
            }
        });
    }

    // Change password
    function editPass(id) {
        const oldPassword = document.getElementById("Old-Password").value.trim();
        const newPassword = document.getElementById("New-Password").value.trim();
        const message = document.getElementById("msg2");
        const oldPasswordError = document.getElementById("oldPasswordError");
        const newPasswordError = document.getElementById("newPasswordError");

        oldPasswordError.textContent = '';
        newPasswordError.textContent = '';

        if (!oldPassword) {
            oldPasswordError.textContent = 'Please enter your old password.';
            return false;
        }

        if (!newPassword) {
            newPasswordError.textContent = ' Ascertainable'
        } else if (!/^\s*[^\s]{5,}\s*$/.test(newPassword)) {
            newPasswordError.textContent = 'New password must contain at least 5 characters.';
            return false;
        }

        fetch(`/userprofile/${id}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ oldpassword: oldPassword, newpassword: newPassword })
        })
            .then(response => {
                if (!response.ok) throw new Error("Network response was not ok");
                return response.json();
            })
            .then(data => {
                if (data.already) {
                    message.textContent = data.already;
                } else if (data.success) {
                    window.location.href = "/userprofile";
                } else {
                    message.textContent = "Something went wrong";
                }
            })
            .catch(err => console.error(err));
    }

    // Logout confirmation
    function confirmLogout(event) {
        event.preventDefault();
        Swal.fire({
            title: 'Are you sure?',
            text: 'You will be logged out!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Logout'
        }).then(result => {
            if (result.isConfirmed) {
                window.location.href = event.target.href;
            }
        });
    }

    // Copy referral ID
    function copyReferalId() {
        const referalInput = document.getElementById("referalInput");
        referalInput.select();
        document.execCommand("copy");
        toastr.warning("Referral ID copied successfully!");
    }

    // Coupon pagination
    let currentPage = 1;
    const itemsPerPage = 5;
    const totalItems = `<%= couponData.length %>`
    const totalPages = Math.ceil(totalItems / itemsPerPage);

    function showPage(page) {
        const couponItems = document.querySelectorAll('.coupon-item');
        const startIndex = (page - 1) * itemsPerPage;
        const endIndex = startIndex + itemsPerPage;

        couponItems.forEach((item, index) => {
            item.style.display = (index >= startIndex && index < endIndex) ? 'block' : 'none';
        });

        const showingStart = startIndex + 1;
        const showingEnd = Math.min(endIndex, totalItems);
        document.getElementById('showing-info').textContent = 
            `Showing ${showingStart}-${showingEnd} of ${totalItems} coupons`;

        document.getElementById('prev-btn').disabled = page === 1;
        document.getElementById('next-btn').disabled = page === totalPages;

        currentPage = page;
        updatePageNumbers();
    }

    function changePage(direction) {
        const newPage = currentPage + direction;
        if (newPage >= 1 && newPage <= totalPages) {
            showPage(newPage);
        }
    }

    function goToPage(page) {
        if (page >= 1 && page <= totalPages) {
            showPage(page);
        }
    }

    function renderPageNumbers() {
        const pageNumbersContainer = document.getElementById('page-numbers');
        pageNumbersContainer.innerHTML = '';

        for (let i = 1; i <= totalPages; i++) {
            const pageButton = document.createElement('button');
            pageButton.className = 'page-number';
            pageButton.textContent = i;
            pageButton.onclick = () => goToPage(i);
            pageNumbersContainer.appendChild(pageButton);
        }
    }

    function updatePageNumbers() {
        const pageButtons = document.querySelectorAll('.page-number');
        pageButtons.forEach((button, index) => {
            button.classList.toggle('active', index + 1 === currentPage);
        });
    }

    // Order pagination
    let orderCurrentPage = 1;
    const orderItemsPerPage = 5;
    const totalOrderItems = `<%= orderData.length %>`;
    const totalOrderPages = Math.ceil(totalOrderItems / orderItemsPerPage);

    function showOrderPage(page) {
        const orderItems = document.querySelectorAll('.order-item');
        const startIndex = (page - 1) * orderItemsPerPage;
        const endIndex = startIndex + orderItemsPerPage;

        orderItems.forEach((item, index) => {
            item.style.display = (index >= startIndex && index < endIndex) ? 'block' : 'none';
        });

        const showingStart = startIndex + 1;
        const showingEnd = Math.min(endIndex, totalOrderItems);
        document.getElementById('order-showing-info').textContent = 
            `Showing ${showingStart}-${showingEnd} of ${totalOrderItems} orders`;

        document.getElementById('order-prev-btn').disabled = page === 1;
        document.getElementById('order-next-btn').disabled = page === totalOrderPages;

        orderCurrentPage = page;
        updateOrderPageNumbers();
    }

    function changeOrderPage(direction) {
        const newPage = orderCurrentPage + direction;
        if (newPage >= 1 && newPage <= totalOrderPages) {
            showOrderPage(newPage);
        }
    }

    function goToOrderPage(page) {
        if (page >= 1 && page <= totalOrderPages) {
            showOrderPage(page);
        }
    }

    function renderOrderPageNumbers() {
        const pageNumbersContainer = document.getElementById('order-page-numbers');
        pageNumbersContainer.innerHTML = '';

        for (let i = 1; i <= totalOrderPages; i++) {
            const pageButton = document.createElement('button');
            pageButton.className = 'page-number';
            pageButton.textContent = i;
            pageButton.onclick = () => goToOrderPage(i);
            pageNumbersContainer.appendChild(pageButton);
        }
    }

    function updateOrderPageNumbers() {
        const pageButtons = document.querySelectorAll('#order-page-numbers .page-number');
        pageButtons.forEach((button, index) => {
            button.classList.toggle('active', index + 1 === orderCurrentPage);
        });
    }

    // Copy coupon code
    function copyCouponCode(code) {
        navigator.clipboard.writeText(code)
            .then(() => {
                toastr.success(`Coupon code "${code}" copied to clipboard!`);
            })
            .catch(() => {
                const textArea = document.createElement('textarea');
                textArea.value = code;
                document.body.appendChild(textArea);
                textArea.select();
                document.execCommand('copy');
                document.body.removeChild(textArea);
                toastr.success(`Coupon code "${code}" copied to clipboard!`);
            });
    }

    // Initialize
    document.addEventListener('DOMContentLoaded', () => {
        hideErrorMessages();
        if (totalItems > 0) {
            showPage(1);
            renderPageNumbers();
        }
        if (totalOrderItems > 0) {
            showOrderPage(1);
            renderOrderPageNumbers();
        }
    });
</script>
<script>
    function handlePayNow(orderId, orderIdStr, productId) {
        const couponCode = ''; // Assuming no coupon for retry, adjust if needed
        fetch('/order/retryPayment', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ orderId, productId })
        })
        .then(response => response.json())
        .then(data => {
            console.log("calling user profile to veriyorder funtion =>>>",data);
            
            if (data.success ===true) {
                
                const options = {
                    "key": data.key_id,
                    "amount": data.order.amount,
                    "currency": "INR",
                    "name": "furni world",
                    "description": "Retry Payment for Order",
                    "image": "/user/icon/estoreLogo.png",
                    "order_id": data.order.id,
                    "handler": function (response) {
                        
                        fetch('/order/retrypaymentverification', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                paymentId: response.razorpay_payment_id,
                                order_id: response.razorpay_order_id,
                                razorpay_signature: response.razorpay_signature,
                                couponCode: couponCode,
                                productId: productId,
                                initial_ID:data.initial_ID
                            })
                        })
                        .then(response => response.json())
                        .then(data => {
                            
                            if (data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Payment Successful',
                                    showConfirmButton: false,
                                    timer: 1000
                                });
                                    window.location.href = `/order/orders/${data.orderData}`;
                             
                            } else {
                                Swal.fire({
                                    title: 'Payment Failed',
                                    text: 'Sorry, the payment failed. Please try again.',
                                    icon: 'error',
                                    showCancelButton: true,
                                    confirmButtonText: 'Retry Payment',
                                    cancelButtonText: 'View Order'
                                }).then((result) => {
                                    if (result.isConfirmed) {
                                        handlePayNow(orderId, orderIdStr, productId);
                                    } else if (result.dismiss === Swal.DismissReason.cancel) {
                                        window.location.href = `/order/orders/${data.curentData}`;
                                    }
                                });
                            }
                        });
                    },
                    "prefill": {
                        "contact": "9876543210",
                        "name": "Twinkle Sharma",
                        "email": "smtwinkle@gmail.com"
                    },
                    "notes": {
                        "description": "Retry payment for order",
                    },
                    "theme": {
                        "color": "#2300a3"
                    }
                };

                var razorpayObject = new Razorpay(options);
                razorpayObject.open();

                razorpayObject.on('payment.failed', function (response) {
                    fetch('/order/verifyOrder', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            paymentId: response.error.metadata.payment_id,
                            order_id: response.error.metadata.order_id,
                            razorpay_signature: null,
                            couponCode: couponCode,
                            productId: productId
                        })
                    })
                    .then(response => response.json())
                    .then(data => {
                        Swal.fire({
                            title: 'Payment Failed',
                            text: 'Sorry, the payment failed. Please try again.',
                            icon: 'error',
                            showCancelButton: true,
                            confirmButtonText: 'Retry Payment',
                            cancelButtonText: 'View Order'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                handlePayNow(orderId, orderIdStr, productId);
                            } else if (result.dismiss === Swal.DismissReason.cancel) {
                                window.location.href = `/order/orders/${data.curentData}`;
                            }
                        });
                    });
                });
            } else {
                Swal.fire({
                    title: 'Retry Failed',
                    text: 'Unable to initiate retry payment. Please try again later.',
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
            }
        })
        .catch(error => {
            console.error('Error retrying payment:', error);
            Swal.fire({
                title: 'Error',
                text: 'An error occurred while retrying payment.',
                icon: 'error',
                confirmButtonText: 'OK'
            });
        });
    }



    // Wallet history pagination
let walletCurrentPage = 1;
const walletItemsPerPage = 5;
const totalWalletItems = "<%= userData.walletHistory.length %>";
const totalWalletPages = Math.ceil(totalWalletItems / walletItemsPerPage);

function showWalletPage(page) {
    const walletItems = document.querySelectorAll('.wallet-history-item');
    const startIndex = (page - 1) * walletItemsPerPage;
    const endIndex = startIndex + walletItemsPerPage;

    walletItems.forEach((item, index) => {
        item.style.display = (index >= startIndex && index < endIndex) ? 'table-row' : 'none';
    });

    const showingStart = startIndex + 1;
    const showingEnd = Math.min(endIndex, totalWalletItems);
    document.getElementById('wallet-showing-info').textContent = 
        `Showing ${showingStart}-${showingEnd} of ${totalWalletItems} entries`;

    document.getElementById('wallet-prev-btn').disabled = page === 1;
    document.getElementById('wallet-next-btn').disabled = page === totalWalletPages;

    walletCurrentPage = page;
    updateWalletPageNumbers();
}

function changeWalletPage(direction) {
    const newPage = walletCurrentPage + direction;
    if (newPage >= 1 && newPage <= totalWalletPages) {
        showWalletPage(newPage);
    }
}

function goToWalletPage(page) {
    if (page >= 1 && page <= totalWalletPages) {
        showWalletPage(page);
    }
}

function renderWalletPageNumbers() {
    const pageNumbersContainer = document.getElementById('wallet-page-numbers');
    pageNumbersContainer.innerHTML = '';

    for (let i = 1; i <= totalWalletPages; i++) {
        const pageButton = document.createElement('button');
        pageButton.className = 'page-number';
        pageButton.textContent = i;
        pageButton.onclick = () => goToWalletPage(i);
        pageNumbersContainer.appendChild(pageButton);
    }
}

function updateWalletPageNumbers() {
    const pageButtons = document.querySelectorAll('#wallet-page-numbers .page-number');
    pageButtons.forEach((button, index) => {
        button.classList.toggle('active', index + 1 === walletCurrentPage);
    });
}

// Update initialization in DOMContentLoaded
document.addEventListener('DOMContentLoaded', () => {
    hideErrorMessages();
    if (totalItems > 0) {
        showPage(1);
        renderPageNumbers();
    }
    if (totalOrderItems > 0) {
        showOrderPage(1);
        renderOrderPageNumbers();
    }
    if (totalWalletItems > 0) {
        showWalletPage(1);
        renderWalletPageNumbers();
    }
});
</script>   
