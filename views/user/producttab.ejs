<%- include('../partials/mainheader.ejs')%>

    <style>
        #hurry {
            color: orangered;
            font-weight: 600;
            animation: pulse 1.5s infinite;
        }
        * {
            font-family: 'Inter', Arial, Helvetica, sans-serif;
        }
        #offer {
        color: #f5f5f5;
        background-color: green;
        width: 40px;
        border-radius: 25px;
        text-align: center;
        font-size: 12px;
        }

        #limited {
            color: blue;
            font-weight: 600;
            animation: bounce 2s infinite;
        }

        #available {
            color: green;
            font-weight: 600;
            animation: fadeIn 2s infinite;
        }

        .swal2-popup {
            width: 300px;
            height: 160px;
            font-size: 9px;
        }

        #wishlist {
            color: red;
            fill: red;
            font-size: 35px;
            transition: all 0.3s ease;
        }

        #wishlist:hover {
            transform: scale(1.2);
            filter: drop-shadow(0 0 5px rgba(255, 0, 0, 0.7));
        }

        /* New animations */
        @keyframes pulse {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.05);
            }

            100% {
                transform: scale(1);
            }
        }

        @keyframes bounce {

            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-5px);
            }
        }

        @keyframes fadeIn {
            0% {
                opacity: 0.7;
            }

            50% {
                opacity: 1;
            }

            100% {
                opacity: 0.7;
            }
        }

        /* Enhanced product details styling */
        .product-details-content {
            background: rgba(255, 255, 255, 0.95);
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            transition: all 0.5s ease;
        }

        .product-details-content:hover {
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
            transform: translateY(-5px);
        }

        .product-details-price {
            margin: 20px 0;
        }

        .new-price {
            font-size: 28px;
            font-weight: 700;
            color: #E97730;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.1);
        }

        .text-muted {
            font-size: 20px;
            margin-right: 10px;
        }

        .product-details-meta ul {
            list-style: none;
            padding: 0;
        }

        .product-details-meta li {
            margin-bottom: 12px;
            display: flex;
            align-items: center;
        }

        .product-details-meta .title {
            font-weight: 600;
            margin-right: 10px;
            min-width: 80px;
        }

        /* Enhanced action buttons */
        .product-details-action-wrap {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-top: 30px;
        }

        .btn-hover button {
            background-color: #E97730 !important;
            width: 180px !important;
            height: 60px !important;
            color: white !important;
            border: none !important;
            border-radius: 8px !important;
            font-weight: 600 !important;
            font-size: 16px !important;
            transition: all 0.3s ease !important;
            box-shadow: 0 4px 8px rgba(201, 102, 102, 0.3);
        }

        .btn-hover button:hover {
            transform: translateY(-3px) !important;
            box-shadow: 0 6px 12px rgba(201, 102, 102, 0.4) !important;
            background-color: #b85d5d !important;
        }

        /* Enhanced image gallery */
        .product-details-img-wrap {
            position: relative;
            overflow: hidden;
            border-radius: 15px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        }

        .pd-small-img-style {
            background: #f9f9f9;
            padding: 15px;
            border-radius: 10px;
            margin-top: 20px;
        }

        .product-details-small-img {
            border: 2px solid transparent;
            border-radius: 8px;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .product-details-small-img:hover {
            border-color: #c96;
            transform: scale(1.05);
        }

        .pd-nav-style-2 {
            background: white;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 3px 6px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
        }

        .pd-nav-style-2:hover {
            background: #c96;
            color: white;
            transform: scale(1.1);
        }

        /* Enhanced tabs */
        .description-review-topbar {
            border-bottom: 2px solid #f0f0f0;
            margin-bottom: 30px;
        }

        .description-review-topbar a {
            padding: 15px 25px;
            font-weight: 600;
            color: #666;
            position: relative;
            transition: all 0.3s ease;
        }

        .description-review-topbar a.active,
        .description-review-topbar a:hover {
            color: #c96;
        }

        .description-review-topbar a.active:after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 100%;
            height: 2px;
            background: #c96;
            animation: tabUnderline 0.3s ease-out;
        }

        @keyframes tabUnderline {
            from {
                transform: scaleX(0);
            }

            to {
                transform: scaleX(1);
            }
        }

        /* Related products */
        .related-product-area {
            background: #f9f9f9;
            padding: 80px 0;
            margin-top: 50px;
        }

        .section-title-2 h2 {
            position: relative;
            display: inline-block;
            padding-bottom: 15px;
        }

        .section-title-2 h2:after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 3px;
            background: #c96;
        }
    </style>

