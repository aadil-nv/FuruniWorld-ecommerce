    <style>
        body::-webkit-scrollbar {
            width: 0;
        }

        .product-gallery-item:before {
            opacity: 0;
            visibility: hidden !important;
            border: 0.1rem solid #c96;
        }

        .imf {
            overflow: hidden;
            border-radius: 15px;
            transition: all 0.3s ease;
        }

        .imf img {
            transform: scale(var(--zoom, 1));
            object-fit: cover;
            transform-origin: var(--x) var(--y);
            transition: transform 0.5s cubic-bezier(0.18, 0.9, 0.33, 1.01);
        }

        .imf:hover {
            --zoom: 2.5;
            cursor: crosshair;
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2);
        }
    </style>
    <script>
        const elem = document.querySelector('.imf');

        let x, y, height, width;
        elem.onmouseenter = () => {
            const size = elem.getBoundingClientRect();
            x = size.x;
            y = size.y;
            width = size.width;
            height = size.height;
        }
        elem.onmousemove = e => {
            const horizontel = (e.clientX - x) / width * 100;
            const vertical = (e.clientY - y) / height * 100;
            elem.style.setProperty('--x', horizontel + '%')
            elem.style.setProperty('--y', vertical + '%')
        }

        function addItemInCart(id) {
            console.log(id);
            fetch(`/product/producttab/${id}`, {
                method: "post",
                headers: { "Content-Type": "application/json" },
            })
                .then((response) => {
                    if (response.ok) {
                        // If response is okay, redirect to the cart page
                        window.location.href = '/cart/viewcart';
                    } else {
                        window.location.href = '/cart/viewcart';
                    }
                })
                .catch((err) => {
                    console.log(err);
                    // If an error occurs, handle it accordingly (e.g., show an error message)
                });
        }

        function wishlstProductId(id) {
            console.log('=======================productId==========================', id)
            fetch('/wishlist/wishlist', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ id: id })
            })
                .then(response => {
                    if (response.ok) {
                        return response.json(); // Parse response JSON if response is okay
                    } else {
                        throw new Error('Error adding product to wishlist');
                    }
                })
                .then(data => {
                    console.log('Response Data:', data); // Log the parsed data to the console
                    if (data.message === 'success') {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: "product added in Wishlist",
                            position: 'top-end',
                            timer: 900,
                            showConfirmButton: false
                        });
                    } else {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Success!',
                            text: "Product Alredy in wishlist",
                            position: 'top-end',
                            timer: 900,
                            showConfirmButton: false
                        });
                    }
                })
                .catch(error => {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error!',
                        text: error.message,
                        position: 'top-end',
                        timer: 1000,
                        showConfirmButton: false
                    });

                    console.error('Error:', error);
                });
        }
    </script>

