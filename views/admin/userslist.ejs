<%- include('../partials/asidenav.ejs') %>

<section class="content-main">
    <div class="content-header">
        <div>
            <h2 class="content-title card-title">Users List</h2>
        </div>
    </div>
    <div class="card mb-4">
        <header class="card-header">
            <div class="row gx-3">
                <div class="col-lg-4 col-md-6 me-auto">
                    <input 
                        type="text" 
                        placeholder="Search by name, email, or mobile..." 
                        class="form-control" 
                        id="userSearchInput"
                        onkeyup="searchUsers()"
                    />
                </div>
               
            </div>
        </header>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="usersTable">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th scope="col">Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Mobile No</th>
                            <th scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (user && user.length > 0) { %>
                            <% let UID = 1; %>
                            <% user.forEach(data => { %>
                                <tr id="user-row-<%= data._id %>">
                                    <td><%= UID++ %></td>
                                    <td><b><%= data.name %></b></td>
                                    <td><%= data.email %></td>
                                    <td><%= data.mobile %></td>
                                    <td class="text-end" style="align-items: center; justify-content: center; display: flex;">
                                        <button 
                                            type="button"
                                            onclick="confirmAction('<%= data._id %>')"
                                            class="btn btn-md rounded font-sm user-action-btn <%= data.is_blocked ? 'btn-unblock' : 'btn-block' %>" 
                                            id="btn-<%= data._id %>"
                                            data-blocked="<%= data.is_blocked ? 'true' : 'false' %>"
                                        >
                                            <%= data.is_blocked ? 'Unblock' : 'Block' %>
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center">
                                    <p class="mt-3">No users</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="pagination-area mt-15 mb-50">
        <nav aria-label="Page navigation example">
            <ul class="pagination justify-content-center">
                <% if (typeof totalPages !== 'undefined') { %>
                    <% for(let i = 1; i <= totalPages; i++) { %>
                        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                            <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                        </li>
                    <% } %>
                <% } %>
            </ul>
        </nav>
    </div>
</section>

<footer class="main-footer font-xs">
    <div class="row pb-30 pt-15">
        <div class="col-sm-6">
            <script>
                document.write(new Date().getFullYear());
            </script>
            &copy; Nest - HTML Ecommerce Template.
        </div>
        <div class="col-sm-6">
            <div class="text-sm-end">All rights reserved</div>
        </div>
    </div>
</footer>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/adminpublic/adminlogin/js/vendors/jquery-3.6.0.min.js"></script>
<script src="/adminpublic/adminlogin/js/vendors/bootstrap.bundle.min.js"></script>
<script src="/adminpublic/adminlogin/js/vendors/select2.min.js"></script>
<script src="/adminpublic/adminlogin/js/vendors/perfect-scrollbar.js"></script>
<script src="/adminpublic/adminlogin/js/vendors/jquery.fullscreen.min.js"></script>
<script src="/adminpublic/adminlogin/js/main.js?v=1.1" type="text/javascript"></script>

<style>
.user-action-btn {
    color: white !important;
    width: 80px;
    border: none;
}

.btn-block {
    background-color: #3BB77E !important;
}

.btn-unblock {
    background-color: rgb(202, 59, 40) !important;
}

.user-action-btn:hover {
    opacity: 0.8;
}

.user-action-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}
</style>

<script>
// Function to handle user search with fetch API
// Function to handle user search with fetch API
async function searchUsers(page = 1) {
  const input = document.getElementById('userSearchInput').value;
  const tbody = document.querySelector('#usersTable tbody');
  const pagination = document.querySelector('.pagination');

  try {
    const response = await fetch('/admin-user/usersearch', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ search: input, page }),
    });
    console.log("response", response);
    

    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status}`);
    }

    const data = await response.json();
    console.log("data==========>", data);
    
    // Remove the success check since your backend doesn't send a success field
    // if (!data.success) {
    //   throw new Error(data.message || 'Failed to fetch users');
    // }

    // Clear the existing table body
    tbody.innerHTML = '';

    console.log("data.user", data.user); // Changed from data.users to data.user
    
    // Fixed: Check for data.user instead of data.users
    if (data.user && data.user.length > 0) {
        console.log("Users found, displaying data");
        
      let uid = (data.currentPage - 1) * 5 + 1; // Adjust UID based on page
      data.user.forEach(user => { // Changed from data.users to data.user
        const row = document.createElement('tr');
        row.id = `user-row-${user._id}`;
        row.innerHTML = `
          <td>${uid++}</td>
          <td><b>${user.name}</b></td>
          <td>${user.email}</td>
          <td>${user.mobile}</td>
          <td class="text-end" style="align-items: center; justify-content: center; display: flex;">
            <button 
              type="button"
              onclick="confirmAction('${user._id}')"
              class="btn btn-md rounded font-sm user-action-btn ${user.is_blocked ? 'btn-unblock' : 'btn-block'}" 
              id="btn-${user._id}"
              data-blocked="${user.is_blocked}"
            >
              ${user.is_blocked ? 'Unblock' : 'Block'}
            </button>
          </td>
        `;
        tbody.appendChild(row);
      });
    } else {
      tbody.innerHTML = `
        <tr>
          <td colspan="5" class="text-center">
            <p class="mt-3">No users found</p>
          </td>
        </tr>
      `;
    }

    // Update pagination
    pagination.innerHTML = '';
    if (data.totalPages > 1) {
      for (let i = 1; i <= data.totalPages; i++) {
        const li = document.createElement('li');
        li.className = `page-item ${i === data.currentPage ? 'active' : ''}`;
        li.innerHTML = `<a class="page-link" href="#" onclick="searchUsers(${i}); return false;">${i}</a>`;
        pagination.appendChild(li);
      }
    }
  } catch (error) {
    console.error('Error searching users:', error);
    Swal.fire({
      title: 'Error!',
      text: 'Failed to search users. Please try again.',
      icon: 'error',
      confirmButtonColor: '#d33',
    });
  }
}

// Trigger search on input change (with debounce to avoid excessive requests)
let searchTimeout;
document.getElementById('userSearchInput').addEventListener('input', () => {
  clearTimeout(searchTimeout);
  searchTimeout = setTimeout(() => searchUsers(1), 300); // Debounce for 300ms
});

// Function to handle user blocking/unblocking with fetch API
async function blockUser(userId) {
  const button = document.getElementById(`btn-${userId}`);
  const originalText = button.textContent;
  const originalClass = button.className;

  try {
    button.disabled = true;
    button.textContent = 'Processing...';

    const response = await fetch(`/admin-user/blockuser`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ userId }),
    });

    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status}`);
    }

    const result = await response.json();

    if (result.success) {
      button.textContent = result.is_blocked ? 'Unblock' : 'Block';
      button.className = `btn btn-md rounded font-sm user-action-btn ${result.is_blocked ? 'btn-unblock' : 'btn-block'}`;
      button.setAttribute('data-blocked', result.is_blocked);

      Swal.fire({
        title: 'Success!',
        text: result.is_blocked ? 'User has been blocked successfully.' : 'User has been unblocked successfully.',
        icon: 'success',
        confirmButtonColor: '#3BB77E',
        timer: 2000,
        showConfirmButton: false,
      });
    } else {
      throw new Error(result.message || 'Operation failed');
    }
  } catch (error) {
    console.error('Error blocking/unblocking user:', error);
    button.textContent = originalText;
    button.className = originalClass;
    Swal.fire({
      title: 'Error!',
      text: 'Failed to update user status. Please try again.',
      icon: 'error',
      confirmButtonColor: '#d33',
    });
  } finally {
    button.disabled = false;
  }
}

// Confirmation function for blocking/unblocking user
function confirmAction(userId) {
  event.preventDefault();
  const button = document.getElementById(`btn-${userId}`);
  const isBlocked = button.getAttribute('data-blocked') === 'true';

  Swal.fire({
    title: 'Are you sure?',
    text: `You are about to ${isBlocked ? 'unblock' : 'block'} this user!`,
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: isBlocked ? '#3BB77E' : '#db0b2e',
    cancelButtonColor: isBlocked ? '#d33' : '#3BB77E',
    confirmButtonText: `Yes, ${isBlocked ? 'unblock' : 'block'} it!`,
    allowOutsideClick: false,
    allowEscapeKey: false,
  }).then((result) => {
    if (result.isConfirmed) {
      blockUser(userId);
    }
  });
}
</script>