<%- include('../partials/asidenav.ejs') %>

<section class="content-main">
    <div class="content-header">
        <div>
            <h2 class="content-title card-title">Users List</h2>
        </div>
    </div>
    <div class="card mb-4">
        <header class="card-header">
            <div class="row gx-3">
                <div class="col-lg-4 col-md-6 me-auto">
                    <input 
                        type="text" 
                        placeholder="Search by name, email, or mobile..." 
                        class="form-control" 
                        id="userSearchInput"
                        onkeyup="searchUsers()"
                    />
                </div>
                <div class="col-lg-2 col-6 col-md-3">
                    <select class="form-select">
                        <option>Status</option>
                        <option>Active</option>
                        <option>Disabled</option>
                        <option>Show all</option>
                    </select>
                </div>
                <div class="col-lg-2 col-6 col-md-3">
                    <select class="form-select">
                        <option>Show 20</option>
                        <option>Show 30</option>
                        <option>Show 40</option>
                    </select>
                </div>
            </div>
        </header>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="usersTable">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th scope="col">Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Mobile No</th>
                            <th scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (user && user.length > 0) { %>
                            <% let UID = 1; %>
                            <% user.forEach(data => { %>
                                <tr id="user-row-<%= data._id %>">
                                    <td><%= UID++ %></td>
                                    <td><b><%= data.name %></b></td>
                                    <td><%= data.email %></td>
                                    <td><%= data.mobile %></td>
                                    <td class="text-end" style="align-items: center; justify-content: center; display: flex;">
                                        <button 
                                            type="button"
                                            onclick="confirmAction('<%= data._id %>')"
                                            class="btn btn-md rounded font-sm user-action-btn <%= data.is_blocked ? 'btn-unblock' : 'btn-block' %>" 
                                            id="btn-<%= data._id %>"
                                            data-blocked="<%= data.is_blocked ? 'true' : 'false' %>"
                                        >
                                            <%= data.is_blocked ? 'Unblock' : 'Block' %>
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center">
                                    <p class="mt-3">No users</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="pagination-area mt-15 mb-50">
        <nav aria-label="Page navigation example">
            <ul class="pagination justify-content-center">
                <% if (typeof totalPages !== 'undefined') { %>
                    <% for(let i = 1; i <= totalPages; i++) { %>
                        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                            <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                        </li>
                    <% } %>
                <% } %>
            </ul>
        </nav>
    </div>
</section>

<footer class="main-footer font-xs">
    <div class="row pb-30 pt-15">
        <div class="col-sm-6">
            <script>
                document.write(new Date().getFullYear());
            </script>
            &copy; Nest - HTML Ecommerce Template.
        </div>
        <div class="col-sm-6">
            <div class="text-sm-end">All rights reserved</div>
        </div>
    </div>
</footer>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/adminpublic/adminlogin/js/vendors/jquery-3.6.0.min.js"></script>
<script src="/adminpublic/adminlogin/js/vendors/bootstrap.bundle.min.js"></script>
<script src="/adminpublic/adminlogin/js/vendors/select2.min.js"></script>
<script src="/adminpublic/adminlogin/js/vendors/perfect-scrollbar.js"></script>
<script src="/adminpublic/adminlogin/js/vendors/jquery.fullscreen.min.js"></script>
<script src="/adminpublic/adminlogin/js/main.js?v=1.1" type="text/javascript"></script>

<style>
.user-action-btn {
    color: white !important;
    width: 80px;
    border: none;
}

.btn-block {
    background-color: #3BB77E !important;
}

.btn-unblock {
    background-color: rgb(202, 59, 40) !important;
}

.user-action-btn:hover {
    opacity: 0.8;
}

.user-action-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}
</style>

<script>
// Function to handle user search
function searchUsers() {
    const input = document.getElementById('userSearchInput').value.toLowerCase();
    const table = document.getElementById('usersTable');
    const rows = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

    for (let i = 0; i < rows.length; i++) {
        const row = rows[i];
        const name = row.cells[1].textContent.toLowerCase();
        const email = row.cells[2].textContent.toLowerCase();
        const mobile = row.cells[3].textContent.toLowerCase();

        if (name.includes(input) || email.includes(input) || mobile.includes(input)) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    }
}

// Function to handle user blocking/unblocking with fetch API
async function blockUser(userId) {
    const button = document.getElementById(`btn-${userId}`);
    const originalText = button.textContent;
    const originalColor = button.style.backgroundColor;

    try {
        button.disabled = true;
        button.textContent = 'Processing...';

        console.log('Making request to:', `/admin-user/blockuser`);
        console.log('Request body:', { userId });

        const response = await fetch(`/admin-user/blockuser`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({ userId })
        });

        console.log('Response status:', response.status);
        console.log('Response headers:', response.headers);

        // Check if response is actually JSON before parsing
        const contentType = response.headers.get('content-type');
        if (!contentType || !contentType.includes('application/json')) {
            // Try to get the response as text to see what's being returned
            const responseText = await response.text();
            console.error('Non-JSON response received:', responseText);
            throw new Error('Server returned non-JSON response. Check server logs.');
        }

        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }

        const result = await response.json();
        console.log('Response data:', result);

        if (result.success) {
            // Update button text and classes based on new status
            button.textContent = result.is_blocked ? 'Unblock' : 'Block';
            
            // Remove old classes and add new ones
            button.classList.remove('btn-block', 'btn-unblock');
            button.classList.add(result.is_blocked ? 'btn-unblock' : 'btn-block');
            
            // Update the data attribute to reflect new status
            button.setAttribute('data-blocked', result.is_blocked.toString());

            Swal.fire({
                title: 'Success!',
                text: result.is_blocked ? 'User has been blocked successfully.' : 'User has been unblocked successfully.',
                icon: 'success',
                confirmButtonColor: '#3BB77E',
                timer: 2000,
                showConfirmButton: false
            });
        } else {
            throw new Error(result.message || 'Operation failed');
        }
    } catch (error) {
        console.error('Error details:', error);
        button.textContent = originalText;
        button.style.backgroundColor = originalColor;

        let errorMessage = 'Failed to update user status. Please try again.';
        
        // Provide more specific error messages
        if (error.message.includes('Non-JSON response')) {
            errorMessage = 'Server error occurred. Please check if the endpoint exists and is working properly.';
        } else if (error.message.includes('Failed to fetch')) {
            errorMessage = 'Network error. Please check your connection and try again.';
        }

        Swal.fire({
            title: 'Error!',
            text: errorMessage,
            icon: 'error',
            confirmButtonColor: '#d33'
        });
    } finally {
        button.disabled = false;
    }
}

// Confirmation function for blocking/unblocking user
function confirmAction(userId) {
    event.preventDefault();
    
    const button = document.getElementById(`btn-${userId}`);
    const isBlocked = button.getAttribute('data-blocked') === 'true';
    
    Swal.fire({
        title: 'Are you sure?',
        text: `You are about to ${isBlocked ? 'unblock' : 'block'} this user!`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: isBlocked ? '#3BB77E' : '#db0b2e',
        cancelButtonColor: isBlocked ? '#d33' : '#3BB77E',
        confirmButtonText: `Yes, ${isBlocked ? 'unblock' : 'block'} it!`,
        allowOutsideClick: false,
        allowEscapeKey: false
    }).then((result) => {
        if (result.isConfirmed) {
            blockUser(userId);
        }
    });
}
</script>