<%- include('../partials/asidenav.ejs')%>

<section class="content-main">
    <div class="content-header">
        <div>
            <h2 class="content-title card-title">Users List</h2>
        </div>
    </div>
    <div class="card mb-4">
        <header class="card-header">
            <div class="row gx-3">
                <div class="col-lg-4 col-md-6 me-auto">
                    <input type="text" placeholder="Search..." class="form-control" />
                </div>
                <div class="col-lg-2 col-6 col-md-3">
                    <select class="form-select">
                        <option>Status</option>
                        <option>Active</option>
                        <option>Disabled</option>
                        <option>Show all</option>
                    </select>
                </div>
                <div class="col-lg-2 col-6 col-md-3">
                    <select class="form-select">
                        <option>Show 20</option>
                        <option>Show 30</option>
                        <option>Show 40</option>
                    </select>
                </div>
            </div>
        </header>
        <!-- card-header end// -->
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th scope="col">Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Mobile No</th>
                            <th scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(user.length > 0) { %>
                            <% let UID=1; %>
                            <% user.forEach(data => { %>
                                <tr id="user-row-<%= data._id %>">
                                    <td><%= UID++; %></td>
                                    <td><b><%= data.name %></b></td>
                                    <td><%= data.email %></td>
                                    <td><%= data.mobile %></td>
                                    <% if (data.is_blocked === false) { %>
                                        <td class="text-end" style="align-items: center; justify-content: center; display: flex;">
                                            <button 
                                                type="button"
                                                onclick="event.preventDefault(); confirmBlock('<%= data._id %>')" 
                                                class="btn btn-md rounded font-sm user-action-btn" 
                                                style="background-color: #3BB77E; color: white; width: 80px;"
                                                id="btn-<%= data._id %>"
                                            >
                                                Block
                                            </button>
                                        </td>
                                    <% } else { %>
                                        <td class="text-end" style="align-items: center; justify-content: center; display: flex;">
                                            <button 
                                                type="button"
                                                onclick="event.preventDefault(); confirmUnBlock('<%= data._id %>')" 
                                                class="btn btn-md rounded font-sm user-action-btn" 
                                                style="background-color: rgb(202, 59, 40); color: white; width: 80px;"
                                                id="btn-<%= data._id %>"
                                            >
                                                Unblock
                                            </button>
                                        </td>
                                    <% } %>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center">
                                    <p class="mt-3">No users</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            <!-- table-responsive //end -->
        </div>
        <!-- card-body end// -->
    </div>
    <!-- card end// -->
    <div class="pagination-area mt-15 mb-50">
        <nav aria-label="Page navigation example">
            <ul class="pagination justify-content-center">
                <% for(let i = 1; i <= totalPages; i++) { %>
                    <li class="page-item <% if (i == currentPage) { %>active<% } %>">
                        <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                    </li>
                <% } %>
            </ul>
        </nav>
    </div>
</section>
<!-- content-main end// -->

<footer class="main-footer font-xs">
    <div class="row pb-30 pt-15">
        <div class="col-sm-6">
            <script>
                document.write(new Date().getFullYear());
            </script>
            &copy; Nest - HTML Ecommerce Template.
        </div>
        <div class="col-sm-6">
            <div class="text-sm-end">All rights reserved</div>
        </div>
    </div>
</footer>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/adminpublic/adminlogin/js/vendors/jquery-3.6.0.min.js"></script>
<script src="/adminpublic/adminlogin/js/vendors/bootstrap.bundle.min.js"></script>
<script src="/adminpublic/adminlogin/js/vendors/select2.min.js"></script>
<script src="/adminpublic/adminlogin/js/vendors/perfect-scrollbar.js"></script>
<script src="/adminpublic/adminlogin/js/vendors/jquery.fullscreen.min.js"></script>
<script src="/adminpublic/adminlogin/js/main.js?v=1.1" type="text/javascript"></script>

<script>
// Function to handle user blocking with fetch API
async function blockUser(userId) {
    const button = document.getElementById(`btn-${userId}`);
    const originalText = button.textContent;
    const originalColor = button.style.backgroundColor;
    
    try {
        // Show loading state
        button.disabled = true;
        button.textContent = 'Processing...';
        
        const response = await fetch(`/admin-user/blockuser?id=${userId}`, {
            method: 'POST', // Using POST method
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({ userId: userId })
        });
        
        // Check if response is ok
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        const result = await response.json();
        
        // Update button appearance based on response
        if (result.success) {
            if (result.is_blocked === true) {
                button.textContent = 'Unblock';
                button.style.backgroundColor = 'rgb(202, 59, 40)';
                button.setAttribute('onclick', `event.preventDefault(); confirmUnBlock('${userId}')`);
                
                Swal.fire({
                    title: 'Success!',
                    text: 'User has been blocked successfully.',
                    icon: 'success',
                    confirmButtonColor: '#3BB77E',
                    timer: 2000,
                    showConfirmButton: false
                });
            } else {
                button.textContent = 'Block';
                button.style.backgroundColor = '#3BB77E';
                button.setAttribute('onclick', `event.preventDefault(); confirmBlock('${userId}')`);
                
                Swal.fire({
                    title: 'Success!',
                    text: 'User has been unblocked successfully.',
                    icon: 'success',
                    confirmButtonColor: '#3BB77E',
                    timer: 2000,
                    showConfirmButton: false
                });
            }
        } else {
            throw new Error(result.message || 'Operation failed');
        }
    } catch (error) {
        console.error('Error:', error);
        
        // Restore original button state
        button.textContent = originalText;
        button.style.backgroundColor = originalColor;
        
        Swal.fire({
            title: 'Error!',
            text: error.message || 'Failed to update user status. Please try again.',
            icon: 'error',
            confirmButtonColor: '#d33'
        });
    } finally {
        button.disabled = false;
    }
}

// Confirmation function for blocking user
function confirmBlock(userId) {
    event.preventDefault(); // Prevent any default behavior
    
    Swal.fire({
        title: 'Are you sure?',
        text: "You are about to block this user!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#3BB77E',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Yes, block it!',
        allowOutsideClick: false,
        allowEscapeKey: false
    }).then((result) => {
        if (result.isConfirmed) {
            blockUser(userId);
        }
    });
    
    return false; // Prevent any form submission or navigation
}

// Confirmation function for unblocking user
function confirmUnBlock(userId) {
    event.preventDefault(); // Prevent any default behavior
    
    Swal.fire({
        title: 'Are you sure?',
        text: "You are about to unblock this user!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#db0b2e',
        cancelButtonColor: '#3BB77E',
        confirmButtonText: 'Yes, unblock it!',
        allowOutsideClick: false,
        allowEscapeKey: false
    }).then((result) => {
        if (result.isConfirmed) {
            blockUser(userId);
        }
    });
    
    return false; // Prevent any form submission or navigation
}

// Alternative approach using event listeners (more reliable)
document.addEventListener('DOMContentLoaded', function() {
    // Add event listeners to all action buttons
    const actionButtons = document.querySelectorAll('.user-action-btn');
    
    actionButtons.forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            const userId = this.id.replace('btn-', '');
            const action = this.textContent.toLowerCase().trim();
            
            if (action === 'block') {
                confirmBlockWithListener(userId);
            } else if (action === 'unblock') {
                confirmUnBlockWithListener(userId);
            }
        });
    });
});

// Alternative confirmation functions using event listeners
function confirmBlockWithListener(userId) {
    Swal.fire({
        title: 'Are you sure?',
        text: "You are about to block this user!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#3BB77E',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Yes, block it!'
    }).then((result) => {
        if (result.isConfirmed) {
            blockUser(userId);
        }
    });
}

function confirmUnBlockWithListener(userId) {
    Swal.fire({
        title: 'Are you sure?',
        text: "You are about to unblock this user!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#db0b2e',
        cancelButtonColor: '#3BB77E',
        confirmButtonText: 'Yes, unblock it!'
    }).then((result) => {
        if (result.isConfirmed) {
            blockUser(userId);
        }
    });
}
</script>