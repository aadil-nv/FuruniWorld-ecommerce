<%- include('../partials/asidenav.ejs')%>

<section class="content-main">
    <div class="content-header">
        <div>
            <h2 class="content-title card-title">Products</h2>
        </div>
        <div>
            <a type="button" class="btn btn-primary" href="/admin-product/addproduct">add Products</a>
        </div>
    </div>

    <div class="card">
        <header class="card-header">
            <div class="row gx-3">
                <div class="col-lg-4 col-md-6 me-auto">
                    <input 
                        type="text" 
                        placeholder="Search by product name, category, or brand..." 
                        class="form-control" 
                        id="productSearchInput"
                    />
                </div>
            </div>
        </header>
        <div class="card-body">
            <div class="row">
                <div class="col-md-12">
                    <div class="table-responsive">
                        <table id="productsTable" class="table table-hover">
                            <thead>
                                <tr>
                                    <th>No.</th>
                                    <th>Image</th>
                                    <th>Product Name</th>
                                    <th>Quantity</th>
                                    <th>Category</th>
                                    <th>Price</th>
                                    <th>Edit</th>
                                    <th>List/unList</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(product.length > 0){%>
                                    <% UID=1 %>
                                    <% product.forEach (data=>{ %>
                                        <tr>
                                            <td><%= UID++ %></td>
                                            <td><img src="/uploads/<%= data.productimage[0] %>" width="50px" class="rounded-3" /></td>
                                            <td><%= data.productname %></td>
                                            <td><%= data.productquadity %></td>
                                            <td><%= data.categoryId %></td>
                                            <td><%= data.productprice %></td>
                                            <td>
                                                <a href="/admin-product/editproductdetiles/<%= data._id %>" style="background-color: #3BB77E;">
                                                    <button class="btn btn-md rounded font-sm" style="background-color: #3BB77E;">Edit</button>
                                                </a>
                                            </td>
                                            <%if (data.isListed===true){ %>
                                                <td>
                                                    <a onclick="confirmBlock('<%= data._id %>')">
                                                        <button class="btn btn-md rounded font-sm" style="width:68px; background-color: #9cb73b;">List</button>
                                                    </a>
                                                </td>
                                            <%}else{%>
                                                <td>
                                                    <a onclick="confirmUnBlock('<%= data._id %>')">
                                                        <button class="btn btn-md rounded font-sm" style="background-color: rgb(218, 79, 79);">unList</button>
                                                    </a>
                                                </td>
                                            <% } %>
                                        </tr>
                                    <% })%>
                                <% }else{ %>
                                    <tr>
                                        <td colspan="8" class="text-center">
                                            <p class="mt-3">No products</p>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="pagination-area mt-15 mb-50">
        <nav aria-label="Page navigation example">
            <ul class="pagination justify-content-start">
                <% for(let i = 1; i <= totalPages; i++) { %>
                    <li class="page-item <% if (i == currentPage) { %>active<% } %>">
                        <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                    </li>
                <% } %>
            </ul>
        </nav>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<script>
// Function to handle product search with fetch API
async function searchProducts(page = 1) {
    const input = document.getElementById('productSearchInput').value;
    const tbody = document.querySelector('#productsTable tbody');
    const pagination = document.querySelector('.pagination');

    try {
        const response = await fetch('/admin-product/productsearch', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ search: input, page }),
        });

        console.log("response", response);

        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }

        const data = await response.json();
        console.log("data==========>", data);

        if (!data.success) {
            throw new Error(data.message || 'Failed to fetch products');
        }

        // Clear the existing table body
        tbody.innerHTML = '';

        console.log("data.products", data.products);

        if (data.products && data.products.length > 0) {
            console.log("Products found, displaying data");

            let uid = (data.currentPage - 1) * 10 + 1; // Adjust UID based on page (perPage = 10)
            data.products.forEach(product => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${uid++}</td>
                    <td><img src="/uploads/${product.productimage[0]}" width="50px" class="rounded-3" /></td>
                    <td>${product.productname}</td>
                    <td>${product.productquadity}</td>
                    <td>${product.categoryId}</td>
                    <td>${product.productprice}</td>
                    <td>
                        <a href="/admin-product/editproductdetiles/${product._id}" style="background-color: #3BB77E;">
                            <button class="btn btn-md rounded font-sm" style="background-color: #3BB77E;">Edit</button>
                        </a>
                    </td>
                    <td>
                        ${product.isListed ? 
                            `<a onclick="confirmBlock('${product._id}')">
                                <button class="btn btn-md rounded font-sm" style="width:68px; background-color: #9cb73b;">List</button>
                            </a>` : 
                            `<a onclick="confirmUnBlock('${product._id}')">
                                <button class="btn btn-md rounded font-sm" style="background-color: rgb(218, 79, 79);">unList</button>
                            </a>`
                        }
                    </td>
                `;
                tbody.appendChild(row);
            });
        } else {
            tbody.innerHTML = `
                <tr>
                    <td colspan="8" class="text-center">
                        <p class="mt-3">No products found</p>
                    </td>
                </tr>
            `;
        }

        // Update pagination
        pagination.innerHTML = '';
        if (data.totalPages > 1) {
            for (let i = 1; i <= data.totalPages; i++) {
                const li = document.createElement('li');
                li.className = `page-item ${i === data.currentPage ? 'active' : ''}`;
                li.innerHTML = `<a class="page-link" href="#" onclick="searchProducts(${i}); return false;">${i}</a>`;
                pagination.appendChild(li);
            }
        }
    } catch (error) {
        console.error('Error searching products:', error);
        Swal.fire({
            title: 'Error!',
            text: 'Failed to search products. Please try again.',
            icon: 'error',
            confirmButtonColor: '#d33',
        });
    }
}

// Trigger search on input change (with debounce to avoid excessive requests)
let searchTimeout;
document.getElementById('productSearchInput').addEventListener('input', () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => searchProducts(1), 300); // Debounce for 300ms
});

// Original confirmation functions for list/unlist
function confirmBlock(userId) {
    Swal.fire({
        title: 'Are you sure?',
        text: "You are about to unList Product!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#db0b2e',
        cancelButtonColor: '#3BB77E',
        confirmButtonText: 'Yes, unList it!'
    }).then((result) => {
        if (result.isConfirmed) {
            window.location.href = "/admin-product/listProduct?id=" + userId;
        }
    });
}

function confirmUnBlock(userId) {
    Swal.fire({
        title: 'Are you sure?',
        text: "You are about to List this Product!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#db0b2e',
        cancelButtonColor: '#3BB77E',
        confirmButtonText: 'Yes, List it!'
    }).then((result) => {
        if (result.isConfirmed) {
            window.location.href = "/admin-product/listProduct?id=" + userId;
        }
    });
}
</script>