<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>Nest Dashboard</title>
        <meta http-equiv="x-ua-compatible" content="ie=edge" />
        <meta name="description" content="" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta property="og:title" content="" />
        <meta property="og:type" content="" />
        <meta property="og:url" content="" />
        <meta property="og:image" content="" />
        <!-- Favicon -->
        <link rel="shortcut icon" type="image/x-icon" href="/adminpublic/adminlogin/imgs/theme/favicon.svg" />
        <!-- Template CSS -->
        <link href="/adminpublic/adminlogin/css/main.css?v=1.1" rel="stylesheet" type="text/css" />
        <!-- Font Awesome for the eye icon -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
        <style>
            :root {
                --primary-color: #3a7bd5;
                --error-color: #dc3545;
                --success-color: #28a745;
            }
            .content-main {
                display: flex;
                justify-content: center;
                align-items: center;
                min-height: 100vh;
                margin: 0;
                padding: 20px;
                background-color: #f5f5f5;
            }
            .card-login {
                max-width: 400px;
                width: 100%;
                background-color: var(--primary-color) !important;
                border-radius: 10px;
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
                transition: background-color 0.5s ease;
            }
            .card-login.error-theme {
                background-color: var(--success-color) !important;
            }
            .card-body {
                padding: 30px;
            }
            .card-title {
                color: #fff;
                text-align: center;
                font-weight: 600;
                margin-bottom: 25px !important;
            }
            /* Updated error message styles with red color */
            .error-message {
                background-color: rgba(255, 255, 255, 0.9);
                color: var(--error-color);
                border-radius: 5px;
                padding: 10px;
                margin-bottom: 15px;
                text-align: center;
                font-weight: 500;
                border-left: 4px solid var(--error-color);
                box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                transform: translateY(-20px);
                opacity: 0;
                animation: slideIn 0.5s forwards;
                display: none;
            }
            @keyframes slideIn {
                to {
                    transform: translateY(0);
                    opacity: 1;
                }
            }
            .form-control {
                border-radius: 5px;
                padding: 12px 15px;
                border: none;
                background-color: rgba(255, 255, 255, 0.9);
            }
            .form-control:focus {
                box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.3);
            }
            .btn-primary {
                background-color: var(--primary-color);
                border: none;
                border-radius: 5px;
                padding: 12px 0;
                font-weight: 600;
                transition: all 0.3s ease;
                display: block;
                width: 100% !important;
                margin: 0 auto;
            }
            .btn-primary:hover {
                background-color: #2c6ec5;
                transform: translateY(-2px);
            }
            .password-container {
                position: relative;
            }
            .password-toggle {
                position: absolute;
                right: 10px;
                top: 12px;
                cursor: pointer;
                color: #6c757d;
            }
            .password-requirements {
                color: white;
                font-size: 12px;
                margin-top: 5px;
                margin-bottom: 15px;
                background-color: rgba(0, 0, 0, 0.2);
                padding: 8px;
                border-radius: 5px;
            }
        </style>
    </head>

    <body>
        <main>
            <section class="content-main">
                <div class="card mx-auto card-login" id="login-card">
                    <div class="card-body">
                        <h2 class="card-title">Admin Sign In</h2>
                        <div id="error-container">
                            <p id="show1" class="error-message"></p>
                            <% if(typeof message!=='undefined' ){ %>
                                <h6 id="errorMessage" class="error-message" style="display: block;">
                                    <%= message %>
                                </h6>
                                <script>
                                    // Animate the server-side error message and change theme
                                    document.addEventListener('DOMContentLoaded', function() {
                                        const errorMsg = document.getElementById('errorMessage');
                                        const loginCard = document.getElementById('login-card');
                                        errorMsg.style.display = 'block';
                                        loginCard.classList.add('error-theme');
                                        setTimeout(() => {
                                            errorMsg.style.animation = 'slideIn 0.5s forwards';
                                        }, 100);
                                    });
                                </script>
                            <% } %>
                        </div>
                        <form action="/admin-auth/adminlogin" method="post" onsubmit="return validateForm()">
                            <div class="mb-3">
                                <input class="form-control" id="email" name="email" placeholder="Email address" type="text" />
                            </div>
                            <div class="mb-3 password-container">
                                <input class="form-control" id="password" name="password" placeholder="Password" type="password" />
                                <span class="password-toggle" onclick="togglePassword()">
                                    <i id="eyeIcon" class="fa-solid fa-eye"></i>
                                </span>
                            </div>
                            
                            <div class="mb-3">
                                <button type="submit" class="btn btn-primary">Login</button>
                            </div>
                        </form>
                    </div>
                </div>
            </section>
        </main>
        <script src="/admin/public/adminlogin/js/vendors/jquery-3.6.0.min.js"></script>
        <script src="/admin/public/adminlogin/js/vendors/bootstrap.bundle.min.js"></script>
        <script src="/admin/public/adminlogin/js/vendors/jquery.fullscreen.min.js"></script>
        <script src="/admin/public/adminlogin/js/main.js?v=1.1" type="text/javascript"></script>

        <script>
            function validateForm() {
                let email = document.getElementById("email").value;
                let password = document.getElementById("password").value;
                let errorElement = document.getElementById("show1");
                let loginCard = document.getElementById("login-card");
                
                // Reset error display and theme
                errorElement.style.display = "none";
                errorElement.style.animation = "none";
                loginCard.classList.remove("error-theme");
                errorElement.offsetHeight; // Trigger reflow
                errorElement.style.animation = null;

                // Email validation - proper format
                let emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailRegex.test(email)) {
                    errorElement.innerHTML = "Please enter a valid email address";
                    errorElement.style.display = "block";
                    loginCard.classList.add("error-theme");
                    setTimeout(() => {
                        errorElement.style.animation = "slideIn 0.5s forwards";
                    }, 10);
                    return false;
                }
                
                // Password validation - at least one uppercase, one lowercase, and one symbol
                let uppercaseRegex = /[A-Z]/;
                let lowercaseRegex = /[a-z]/;
                let symbolRegex = /[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]+/;
                
                if (!uppercaseRegex.test(password)) {
                    errorElement.innerHTML = "Password must contain at least one uppercase letter";
                    errorElement.style.display = "block";
                    loginCard.classList.add("error-theme");
                    setTimeout(() => {
                        errorElement.style.animation = "slideIn 0.5s forwards";
                    }, 10);
                    return false;
                }
                
                if (!lowercaseRegex.test(password)) {
                    errorElement.innerHTML = "Password must contain at least one lowercase letter";
                    errorElement.style.display = "block";
                    loginCard.classList.add("error-theme");
                    setTimeout(() => {
                        errorElement.style.animation = "slideIn 0.5s forwards";
                    }, 10);
                    return false;
                }
                
                if (!symbolRegex.test(password)) {
                    errorElement.innerHTML = "Password must contain at least one special symbol";
                    errorElement.style.display = "block";
                    loginCard.classList.add("error-theme");
                    setTimeout(() => {
                        errorElement.style.animation = "slideIn 0.5s forwards";
                    }, 10);
                    return false;
                }
                
                return true;
            }
            
            function togglePassword() {
                const passwordInput = document.getElementById("password");
                const eyeIcon = document.getElementById("eyeIcon");
                
                if (passwordInput.type === "password") {
                    passwordInput.type = "text";
                    eyeIcon.classList.remove("fa-eye");
                    eyeIcon.classList.add("fa-eye-slash");
                } else {
                    passwordInput.type = "password";
                    eyeIcon.classList.remove("fa-eye-slash");
                    eyeIcon.classList.add("fa-eye");
                }
            }
        </script>
    </body>
</html>