<%- include('../partials/asidenav.ejs')%>

<style>
    #delete{
        background-color: red;
        border: none;
        color: white;
        width: 70px;
        height: 35px;
        border-radius: 5px;
    }
</style>

<section class="content-main">
    <div class="content-header">
        <div>
            <h2 class="content-title card-title">Coupon List</h2>
        </div>
        <div>
            <a href="/admin/createcoupon" class="btn btn-primary btn-sm rounded">Create Coupon</a>
        </div>
    </div>
    <div class="card mb-4">
        <header class="card-header">
            <div class="row gx-3">
                <div class="col-lg-4 col-md-6 me-auto">
                        <input 
                            type="text" 
                            placeholder="Search by name, email, or mobile..." 
                            class="form-control" 
                            id="userSearchInput"
                            onkeyup="searcCoupon()"
                        />
                    </div>
                <div class="col-lg-2 col-6 col-md-3">
                    <select class="form-select">
                        <option>Status</option>
                        <option>Active</option>
                        <option>Disabled</option>
                        <option>Show all</option>
                    </select>
                </div>
                <div class="col-lg-2 col-6 col-md-3">
                    <select class="form-select" id="itemsPerPage" onchange="changeItemsPerPage()">
                        <option value="5" <%= itemsPerPage == 5 ? 'selected' : '' %>>Show 5</option>
                        <option value="10" <%= itemsPerPage == 10 ? 'selected' : '' %>>Show 10</option>
                        <option value="20" <%= itemsPerPage == 20 ? 'selected' : '' %>>Show 20</option>
                        <option value="30" <%= itemsPerPage == 30 ? 'selected' : '' %>>Show 30</option>
                    </select>
                </div>
            </div>
        </header>
        <!-- card-header end// -->
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Serial No.</th>
                            <th scope="col">Name</th>
                            <th scope="col">Coupon Code</th>
                            <th scope="col">Discount Amount</th>
                            <th scope="col">MIN Amount</th>
                            <th scope="col">Status</th>
                            <th scope="col">Expr Date</th>
                            <th scope="col" class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (couponData.length > 0) {%>
                            <% let serialNumber = (currentPage - 1) * itemsPerPage + 1; %>
                            <% couponData.forEach(item => { %>
                                <tr>
                                    <td><%= serialNumber++ %></td>
                                    <td><b><%= item.couponName %></b></td>
                                    <td><%= item.couponCode %></td>
                                    <td><%= item.discountAmount %></td>
                                    <td><%= item.minAmount %></td>
                                    <td><span class="badge rounded-pill alert-warning"><%= item.status %></span></td>
                                    <td><%= item.expiryDate.toDateString() %></td>
                                    <td class="text-end">
                                        <button id="delete" onclick="confirmDelete('<%= item._id %>')">Delete</button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="text-center">
                                    <p class="mt-3">No coupons available</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            <!-- table-responsive //end -->
        </div>
        <!-- card-body end// -->
    </div>
    <!-- card end// -->
    
    <!-- Pagination -->
    <% if (totalPages > 1) { %>
        <div class="pagination-area mt-15 mb-50">
            <nav aria-label="Page navigation example">
                <ul class="pagination justify-content-center">
                    <!-- Previous button -->
                    <% if (currentPage > 1) { %>
                        <li class="page-item">
                            <a class="page-link" href="?page=<%= currentPage - 1 %>&items=<%= itemsPerPage %>" aria-label="Previous">
                                <i class="material-icons md-chevron_left"></i>
                            </a>
                        </li>
                    <% } %>

                    <!-- Page numbers -->
                    <% 
                        let startPage = Math.max(1, currentPage - 2);
                        let endPage = Math.min(totalPages, currentPage + 2);
                        
                        // Show first page if we're not close to it
                        if (startPage > 1) {
                    %>
                        <li class="page-item">
                            <a class="page-link" href="?page=1&items=<%= itemsPerPage %>">1</a>
                        </li>
                        <% if (startPage > 2) { %>
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        <% } %>
                    <% } %>

                    <!-- Current page range -->
                    <% for(let i = startPage; i <= endPage; i++) { %>
                        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                            <a class="page-link" href="?page=<%= i %>&items=<%= itemsPerPage %>"><%= i %></a>
                        </li>
                    <% } %>

                    <!-- Show last page if we're not close to it -->
                    <% if (endPage < totalPages) { %>
                        <% if (endPage < totalPages - 1) { %>
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        <% } %>
                        <li class="page-item">
                            <a class="page-link" href="?page=<%= totalPages %>&items=<%= itemsPerPage %>"><%= totalPages %></a>
                        </li>
                    <% } %>

                    <!-- Next button -->
                    <% if (currentPage < totalPages) { %>
                        <li class="page-item">
                            <a class="page-link" href="?page=<%= currentPage + 1 %>&items=<%= itemsPerPage %>" aria-label="Next">
                                <i class="material-icons md-chevron_right"></i>
                            </a>
                        </li>
                    <% } %>
                </ul>
            </nav>
            
            <!-- Pagination Info -->
            <div class="text-center mt-3">
                <small class="text-muted">
                    Showing <%= (currentPage - 1) * itemsPerPage + 1 %> to 
                    <%= Math.min(currentPage * itemsPerPage, totalCoupons) %> 
                    of <%= totalCoupons %> coupons
                </small>
            </div>
        </div>
    <% } %>
</section>

<script src="/adminpublic/adminlogin/js/vendors/jquery-3.6.0.min.js"></script>
<script src="/adminpublic/adminlogin/js/vendors/bootstrap.bundle.min.js"></script>
<script src="/adminpublic/adminlogin/js/vendors/select2.min.js"></script>
<script src="/adminpublic/adminlogin/js/vendors/perfect-scrollbar.js"></script>
<script src="/adminpublic/adminlogin/js/vendors/jquery.fullscreen.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<!-- Main Script -->
<script src="/adminpublic/adminlogin/js/main.js?v=1.1" type="text/javascript"></script>

<script>
// Function to change items per page
function changeItemsPerPage() {
    const itemsPerPage = document.getElementById('itemsPerPage').value;
    const currentUrl = new URL(window.location.href);
    currentUrl.searchParams.set('items', itemsPerPage);
    currentUrl.searchParams.set('page', 1); // Reset to first page
    window.location.href = currentUrl.toString();
}

function confirmDelete(couponId) {
    Swal.fire({
        title: "Are you sure?",
        text: "Once deleted, you will not be able to recover this coupon!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Yes, delete it",
        cancelButtonText: "No, cancel",
        buttonsStyling: false,
        customClass: {
            confirmButton: "btn btn-danger me-3",
            cancelButton: "btn btn-secondary",
        }
    })
    .then((result) => {
        // If the user clicks the confirm button
        if (result.isConfirmed) {
            // Call the function to delete the coupon
            deleteCoupon(couponId);
        } else {
            // Inform the user that the action was canceled
            Swal.fire({
                title: "Cancelled",
                text: "Your coupon is safe!",
                icon: "info",
            });
        }
    });
}

function deleteCoupon(couponId) {
    console.log(couponId)
    const data = couponId
    fetch('/admin/deletecoupon', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({data})
    })
    .then(response => {
        if (response.ok) {
            Swal.fire({
                title: "Coupon deleted successfully!",
                icon: "success",
                confirmButtonText: "OK",
            })
            .then(() => {
                location.reload();
            });
        } else {
            Swal.fire({
                title: "Error!",
                text: "Failed to delete coupon!",
                icon: "error",
            });
        }
    })
    .catch(error => {
        console.error("Error:", error);
        Swal.fire({
            title: "Error!",
            text: "Failed to delete coupon!",
            icon: "error",
        });
    });
}
</script>